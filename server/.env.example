# Copy to server/.env and fill in. Never commit the real .env (it is git-ignored).

NODE_ENV=development
PORT=3000

# MongoDB (local, Docker or Atlas). The Docker stack sets this for you.
MONGODB_URI=mongodb://localhost:27017/retechex

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRE=7d

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# SMTP (Brevo, Gmail app password, Mailtrap...). Leave SMTP_HOST empty to skip real sending:
# emails are then rendered but not delivered, which is fine for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ReTechEx" <no-reply@example.com>

# Demo data (npm run seed): password for the seeded demo accounts
SEED_PASSWORD=Demo12345

# First real admin (npm run create-admin). Use a strong, unique password (12+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Admin
